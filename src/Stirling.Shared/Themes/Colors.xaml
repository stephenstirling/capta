<?xml version="1.0" encoding="utf-8"?>
<!--
    Stirling brand palette. Merge into App.xaml *after* XamlControlsResources:

        <ResourceDictionary Source="ms-appx:///Stirling.Shared/Themes/Colors.xaml" />

    Overrides the WinUI accent ramp with amber (#FFB547) so every Fluent control
    picks it up, and adds Stirling* brushes for app-specific surfaces.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="StirlingAmber">#FFB547</Color>

    <Color x:Key="SystemAccentColor">#FFB547</Color>
    <Color x:Key="SystemAccentColorLight1">#FFC46D</Color>
    <Color x:Key="SystemAccentColorLight2">#FFD393</Color>
    <Color x:Key="SystemAccentColorLight3">#FFE3BC</Color>
    <Color x:Key="SystemAccentColorDark1">#E09A2E</Color>
    <Color x:Key="SystemAccentColorDark2">#B0741A</Color>
    <Color x:Key="SystemAccentColorDark3">#7F520C</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Amber is a light hue: fills use the darker steps and text on accent is dark. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E09A2E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E09A2E" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E09A2E" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7F520C" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7F520C" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#B0741A" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1E1A14" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1E1A14" Opacity="0.7" />

            <SolidColorBrush x:Key="StirlingAccentBrush" Color="#FFB547" />
            <SolidColorBrush x:Key="StirlingAccentStrongBrush" Color="#B0741A" />
            <SolidColorBrush x:Key="StirlingSurfaceBrush" Color="#FBF8F3" />
            <SolidColorBrush x:Key="StirlingSurfaceRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StirlingInkBrush" Color="#1E1A14" />
            <SolidColorBrush x:Key="StirlingInkMutedBrush" Color="#6B6257" />
            <SolidColorBrush x:Key="StirlingStrokeBrush" Color="#1E1A14" Opacity="0.12" />
            <SolidColorBrush x:Key="StirlingScrimBrush" Color="#000000" Opacity="0.45" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB547" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFB547" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFB547" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD393" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFD393" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFC46D" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1E1A14" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1E1A14" Opacity="0.7" />

            <SolidColorBrush x:Key="StirlingAccentBrush" Color="#FFB547" />
            <SolidColorBrush x:Key="StirlingAccentStrongBrush" Color="#FFC46D" />
            <SolidColorBrush x:Key="StirlingSurfaceBrush" Color="#1C1A17" />
            <SolidColorBrush x:Key="StirlingSurfaceRaisedBrush" Color="#26231F" />
            <SolidColorBrush x:Key="StirlingInkBrush" Color="#F5F1EA" />
            <SolidColorBrush x:Key="StirlingInkMutedBrush" Color="#B3AA9E" />
            <SolidColorBrush x:Key="StirlingStrokeBrush" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="StirlingScrimBrush" Color="#000000" Opacity="0.55" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StirlingAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StirlingAccentStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StirlingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StirlingSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StirlingInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StirlingInkMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="StirlingStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StirlingScrimBrush" Color="#000000" Opacity="0.6" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
