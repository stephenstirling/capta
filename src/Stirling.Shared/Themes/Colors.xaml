<?xml version="1.0" encoding="utf-8"?>
<!--
    Stirling brand palette: the single theme dictionary for Capta (and later Ocula).
    Token values come from design/xaml/CaptaTheme.xaml and design/mockups/*.html;
    update them here, not in a second dictionary.

    Merge into App.xaml *after* XamlControlsResources:

        <ResourceDictionary Source="ms-appx:///Stirling.Shared/Themes/Colors.xaml" />

    Besides the Capta* tokens, this overrides the WinUI accent ramp and accent brushes
    with amber (#FFB547) so stock Fluent controls match the design.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

