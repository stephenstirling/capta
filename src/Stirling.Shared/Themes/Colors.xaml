            <SolidColorBrush x:Key="CaptaHoverOverlayBrush" Color="{StaticResource CaptaHoverOverlayColor}" />
            <Color x:Key="CaptaPressedOverlayColor">#0AFFFFFF</Color>
            <SolidColorBrush x:Key="CaptaPressedOverlayBrush" Color="{StaticResource CaptaPressedOverlayColor}" />
            <!-- Secondary text on floating surfaces (card subline, menu descriptions) -->
            <Color x:Key="CaptaFloatingMutedColor">#A7AEB8</Color>
            <SolidColorBrush x:Key="CaptaFloatingMutedBrush" Color="{StaticResource CaptaFloatingMutedColor}" />
            <!-- Split-button dropdown half -->
