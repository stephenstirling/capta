            <SolidColorBrush x:Key="CaptaFloatingSurfaceBrush" Color="{StaticResource CaptaFloatingSurfaceColor}" />
            <Color x:Key="CaptaFloatingBorderColor">#343A44</Color>
            <SolidColorBrush x:Key="CaptaFloatingBorderBrush" Color="{StaticResource CaptaFloatingBorderColor}" />
            <Color x:Key="CaptaFloatingTextColor">#D7DBE0</Color>
            <SolidColorBrush x:Key="CaptaFloatingTextBrush" Color="{StaticResource CaptaFloatingTextColor}" />
            <Color x:Key="CaptaDividerColor">#3A404A</Color>
            <SolidColorBrush x:Key="CaptaDividerBrush" Color="{StaticResource CaptaDividerColor}" />
            <Color x:Key="CaptaTextFaintColor">#6B7380</Color>
            <SolidColorBrush x:Key="CaptaTextFaintBrush" Color="{StaticResource CaptaTextFaintColor}" />
            <!-- Icon-button hover: rgba(255,255,255,0.08) -->
