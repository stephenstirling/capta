<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Brand resources shared by Stirling apps (Capta, Ocula).
    - Themes/Colors.xaml: Light/Dark/HighContrast ThemeDictionaries, amber accent.
    - Assets/<App>/: MSIX logos and .ico files, generated by tools/generate_icons.py.
      Apps link these via build/Stirling.Shared.AppIcons.targets.
  -->
  <PropertyGroup>
    <RootNamespace>Stirling.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**" />
    <None Include="build\**" />
  </ItemGroup>
</Project>
