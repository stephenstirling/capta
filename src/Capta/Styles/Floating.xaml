<?xml version="1.0" encoding="utf-8"?>
<!--
    Control styling for the floating surfaces (toolbar, after-capture card), matching the
    mockups' ".ib" icon buttons: transparent until hovered. Merge into a window root's
    Resources, not App.xaml, so ordinary dialogs keep standard Fluent buttons.
    Colours come from the Capta* tokens in Stirling.Shared/Themes/Colors.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icon buttons: transparent until hovered (.ib in the mockup). -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaFloatingTextBrush" />
    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaFloatingTextBrush" />
    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />

    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="CaptaPressedOverlayBrush" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="CaptaFloatingTextBrush" />
    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="CaptaFloatingTextBrush" />
    <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />
    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="CaptaAccentTextBrush" />
    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="CaptaAccentTextBrush" />
    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="CaptaAccentTextBrush" />

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
