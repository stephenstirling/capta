<?xml version="1.0" encoding="utf-8"?>
<!--
    Control styling for the floating surfaces (toolbar, after-capture card), matching the
    mockups' ".ib" icon buttons: transparent until hovered. Merge into a window root's
    Resources, not App.xaml, so ordinary dialogs keep standard Fluent buttons.
    Colours come from the Capta* tokens in Stirling.Shared/Themes/Colors.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-dependent overrides. They live in ThemeDictionaries and follow the Capta*Color
        tokens with ThemeResource, so they switch when a window's theme changes (a plain
        StaticResource alias would keep the colour from when the window loaded).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{ThemeResource CaptaTextSecondaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{ThemeResource CaptaTextSecondaryColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource CaptaFloatingTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource CaptaAccentTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource CaptaAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{ThemeResource CaptaOnAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{ThemeResource CaptaDividerColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{ThemeResource CaptaTextSecondaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{ThemeResource CaptaTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{ThemeResource CaptaTextSecondaryColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaFloatingTextBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaFloatingTextBrush" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="CaptaPressedOverlayBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="CaptaFloatingTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="CaptaFloatingTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="CaptaAccentTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="CaptaAccentTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="CaptaAccentTextBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="CaptaAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="CaptaAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="CaptaAccentBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="CaptaOnAccentBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="CaptaOnAccentBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="CaptaOnAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="CaptaDividerBrush" />
            <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="CaptaDividerBrush" />
            <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="CaptaDividerBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="CaptaTextSecondaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="CaptaTextBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="CaptaTextSecondaryBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- Icon buttons: transparent until hovered (.ib in the mockup). -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Switches (mockups' toggle): amber track with a near-black knob when on; flat grey when off. -->
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
</ResourceDictionary>
