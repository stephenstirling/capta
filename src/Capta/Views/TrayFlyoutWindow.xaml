<?xml version="1.0" encoding="utf-8"?>
<!-- Tray flyout: design/mockups/Tray.html and screenshots/05-tray-flyout.png. -->
<Window
    x:Class="Capta.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid x:Name="Root" Padding="24,12,24,36">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Height" Value="76" />
                    <Setter Property="Padding" Value="14,12" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <!-- Recent capture cell; an empty one is a placeholder. -->
                <Style x:Key="RecentCell" TargetType="Border">
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background" Value="{ThemeResource CaptaControlBrush}" />
                </Style>
                <Style x:Key="Segment" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Width="380"
            Height="560"
            Padding="18"
            Background="{ThemeResource CaptaSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource CaptaBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusWindow}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13" Foreground="{ThemeResource CaptaTextBrush}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: Aperture glyph, name, settings. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 9V5.5A2.5 2.5 0 0 1 5.5 3H9M15 3h3.5A2.5 2.5 0 0 1 21 5.5V9" Stroke="{ThemeResource CaptaAccentBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M3 15v3.5A2.5 2.5 0 0 0 5.5 21H9M21 15v3.5a2.5 2.5 0 0 1-2.5 2.5H15" Stroke="{ThemeResource CaptaApertureLowerBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Ellipse Canvas.Left="7.8" Canvas.Top="7.8" Width="8.4" Height="8.4" Fill="{ThemeResource CaptaLensBrush}" />
                                <Ellipse Canvas.Left="10.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="{ThemeResource CaptaAccentBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="Capta" />
                        <Button
                            Grid.Column="2"
                            Width="44"
                            Height="44"
                            Padding="0"
                            CornerRadius="10"
                            BorderThickness="0"
                            Click="OnSettings"
                            ToolTipService.ToolTip="Startup &amp; shortcuts">
                            <c:LineIcon Data="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M18 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM12 12a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM20 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0z" />
                        </Button>
                    </Grid>

                    <!-- Capture tiles. Region is the primary (amber). -->
                    <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaControlHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaControlBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="CaptaControlBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaTextBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaTextBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>

                        <Button Style="{StaticResource Tile}" Padding="14,12" FontWeight="Bold" CornerRadius="12" Click="OnRegion">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaOnAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaOnAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaOnAccentColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaOnAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaOnAccentColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaOnAccentColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaAccentBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaAccentBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaAccentBrush" />
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaOnAccentBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaOnAccentBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaOnAccentBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <Grid>
                                <c:LineIcon HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" Dashed="True" />
                                <TextBlock VerticalAlignment="Bottom" Text="Region" />
                                <TextBlock x:Name="RegionKeys" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" FontWeight="SemiBold" Text="PrtSc" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Tile}" Click="OnWindow" ToolTipService.ToolTip="Pick a window (Alt+PrtSc captures the active window)">
                            <Grid>
                                <c:LineIcon HorizontalAlignment="Left" VerticalAlignment="Top" Data="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 9h18" />
                                <TextBlock VerticalAlignment="Bottom" Text="Window" />
                                <TextBlock x:Name="WindowKeys" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Alt+PrtSc" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Style="{StaticResource Tile}" Click="OnFullScreen" ToolTipService.ToolTip="Full screen (Shift+PrtSc)">
                            <Grid>
                                <c:LineIcon HorizontalAlignment="Left" VerticalAlignment="Top" Data="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                                <TextBlock VerticalAlignment="Bottom" Text="Full screen" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" IsEnabled="False" ToolTipService.ToolTip="Coming soon">
                            <Grid>
                                <c:LineIcon HorizontalAlignment="Left" VerticalAlignment="Top" Data="M5 6h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM16 10l5-3v10l-5-3" />
                                <TextBlock VerticalAlignment="Bottom" Text="Record video" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Delay (shared with the toolbar). -->
                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Delay" />
                        <Border Grid.Column="1" Padding="3" Background="{ThemeResource CaptaInsetBrush}" CornerRadius="10">
                            <Border.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource CaptaTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource CaptaTextColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource CaptaSegmentSelectedColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource CaptaTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource CaptaTextColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="CaptaSegmentSelectedBrush" />
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="CaptaSegmentSelectedBrush" />
                                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="CaptaSegmentSelectedBrush" />
                                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="CaptaTextBrush" />
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="CaptaTextBrush" />
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="CaptaTextBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Border.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="DelayOff" Style="{StaticResource Segment}" Tag="0" Click="OnDelay" Content="Off" />
                                <ToggleButton x:Name="Delay3" Style="{StaticResource Segment}" Tag="3" Click="OnDelay" Content="3s" />
                                <ToggleButton x:Name="Delay5" Style="{StaticResource Segment}" Tag="5" Click="OnDelay" Content="5s" />
                                <ToggleButton x:Name="Delay10" Style="{StaticResource Segment}" Tag="10" Click="OnDelay" Content="10s" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent captures this session; click one to bring its card back. -->
                    <StackPanel Grid.Row="3" Spacing="10">
                        <TextBlock FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource CaptaTextMutedBrush}" Text="RECENT" />
                        <Grid x:Name="RecentGrid" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="OculaButton"
                        Grid.Row="4"
                        Height="24"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        CornerRadius="10"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="OnOpenInOcula">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaControlHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaControlBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="CaptaControlBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:LineIcon Size="17" StrokeWidth="1.9" Data="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z" />
                            <TextBlock Text="Open all captures in Ocula" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
