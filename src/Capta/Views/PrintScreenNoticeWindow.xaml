<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Capta.Views.PrintScreenNoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capta">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,40,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource StirlingAccentStrongBrush}" />
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Print Screen opens Snipping Tool" />
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="Windows is set to open Snipping Tool when you press Print Screen, so it competes with Capta for the key." />
            <LineBreak /><LineBreak />
            <Run Text="In Keyboard settings, turn off" />
            <Run FontWeight="SemiBold" Text="Use the Print screen key to open screen capture" /><Run Text="." />
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Not now" Click="OnNotNow" />
            <Button Content="Open Keyboard settings" Style="{StaticResource AccentButtonStyle}" Click="OnOpenSettings" />
        </StackPanel>
    </Grid>
</Window>
