<?xml version="1.0" encoding="utf-8"?>
<!-- Pin to screen: design/mockups/Pinned.html and screenshots/04-pin-to-screen.png. -->
<Window
    x:Class="Capta.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta pin">

    <!--
        Transparent window. The margins around Stage hold the hover bar (above), the hint (below)
        and the shadow; Stage itself sits exactly where the captured pixels were.
    -->
    <Grid
        x:Name="Root"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="PinBarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!--
            The pinned capture: amber outline offset 2px, 10px corners, deep shadow. Stage extends
            4px past the image on each side (Inset) so the outline isn't clipped by layout.
        -->
        <Grid
            x:Name="Stage"
            Margin="40,60,40,60"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            DoubleTapped="OnDoubleTapped"
            PointerMoved="OnStagePointerMoved"
            PointerPressed="OnStagePointerPressed"
            PointerReleased="OnStagePointerReleased"
            PointerWheelChanged="OnPointerWheelChanged">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy" Click="OnCopy">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Actual size" Click="OnActualSize">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Unpin" Click="OnUnpin">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Grid x:Name="ShadowHost" Margin="4" />
            <Border
                BorderBrush="{ThemeResource CaptaAccentBrush}"
                BorderThickness="2"
                CornerRadius="14"
                IsHitTestVisible="False" />
            <Border x:Name="Picture" Margin="4" Background="{ThemeResource CaptaSurfaceBrush}" CornerRadius="10" />

            <!-- Resize corner mark; dragging it scales the pin. -->
            <Grid
                x:Name="ResizeGrip"
                Width="22"
                Height="22"
                Margin="0,0,4,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent">
                <Border
                    Width="14"
                    Height="14"
                    Margin="0,0,8,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    BorderBrush="{ThemeResource CaptaAccentBrush}"
                    BorderThickness="0,0,3,3"
                    CornerRadius="0,0,4,0" />
            </Grid>

            <Border
                x:Name="ZoomBadge"
                Margin="12"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource CaptaReadoutSurfaceBrush}"
                CornerRadius="4"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition />
                </Border.OpacityTransition>
                <TextBlock x:Name="ZoomText" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingTextBrush}" />
            </Border>
        </Grid>

        <!-- Hover bar, above the pin's top-right corner. -->
        <Grid x:Name="BarLayer" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,40,0" Visibility="Collapsed">
            <Grid x:Name="BarShadow" />
            <Border
                x:Name="Bar"
                Padding="4"
                Background="{ThemeResource CaptaFloatingSurfaceBrush}"
                BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <StackPanel Padding="8,0" Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource CaptaFont}" FontSize="12" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Opacity" />
                        <Slider
                            x:Name="OpacitySlider"
                            Width="80"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="20"
                            StepFrequency="5"
                            Value="100"
                            ValueChanged="OnOpacityChanged"
                            AutomationProperties.Name="Pinned capture opacity" />
                        <TextBlock
                            x:Name="OpacityText"
                            Width="34"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CaptaMonoFont}"
                            FontSize="12"
                            Foreground="{ThemeResource CaptaFloatingTextBrush}"
                            Text="100%" />
                    </StackPanel>
                    <Button Style="{StaticResource PinBarButton}" Click="OnClickThrough" ToolTipService.ToolTip="Click through (turn off from the tray menu)">
                        <c:LineIcon Size="17" Data="M5 3l14 8-6 2-2 6zM3 21l6-6" />
                    </Button>
                    <Button Style="{StaticResource PinBarButton}" Click="OnCopy" ToolTipService.ToolTip="Copy (Ctrl+C)">
                        <c:LineIcon Size="16" Data="M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                    </Button>
                    <Button Style="{StaticResource PinBarButton}" Click="OnEdit" ToolTipService.ToolTip="Edit">
                        <c:LineIcon Size="16" Data="M4 20l4-1 11-11-3-3L5 16z" />
                    </Button>
                    <Button Style="{StaticResource PinBarButton}" Click="OnUnpin" ToolTipService.ToolTip="Unpin (Esc)">
                        <c:LineIcon Size="16" Data="M6 6l12 12M18 6L6 18" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            x:Name="Hint"
            Margin="0,0,40,36"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontFamily="{StaticResource CaptaFont}"
            FontSize="12"
            Foreground="{ThemeResource CaptaFloatingMutedBrush}"
            IsHitTestVisible="False"
            Text="Scroll to zoom · drag corner to resize · double-click to unpin"
            Visibility="Collapsed" />
    </Grid>
</Window>
