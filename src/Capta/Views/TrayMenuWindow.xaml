<?xml version="1.0" encoding="utf-8"?>
<!-- Tray icon's right-click menu: compact rows, one icon column, shortcut hints beside the labels. -->
<Window
    x:Class="Capta.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow (DESIGN.md decision 5). -->
    <Grid x:Name="Root" Padding="8,4,8,8">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- A 32 px row. Hover and pressed come from Floating.xaml (CaptaHoverOverlay / CaptaPressedOverlay). -->
                <Style x:Key="MenuRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <!-- Shortcut hints sit next to the label, in the muted mono style. -->
                <Style x:Key="MenuHint" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource CaptaMonoFont}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{ThemeResource CaptaFloatingMutedBrush}" />
                </Style>
                <Style x:Key="MenuDivider" TargetType="Rectangle">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="12,4" />
                    <Setter Property="Fill" Value="{ThemeResource CaptaDividerBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            MinWidth="220"
            MaxWidth="280"
            Padding="0,8"
            Background="{ThemeResource CaptaMenuSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13" Foreground="{ThemeResource CaptaTextBrush}">
                <StackPanel x:Name="Rows" XYFocusKeyboardNavigation="Enabled">

                    <!-- Shown while Windows still opens Snipping Tool on Print Screen. The text wraps rather than being cut off. -->
                    <Grid x:Name="WarningRow" Margin="4,0" Padding="8,4" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:LineIcon Size="16" VerticalAlignment="Center" Foreground="{ThemeResource CaptaAccentTextBrush}" Data="M12 3l10 18H2zM12 10v5M12 18v.5" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Print Screen still opens Snipping Tool" TextWrapping="Wrap" />
                        <HyperlinkButton
                            Grid.Column="2"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Click="OnFixPrintScreen"
                            Content="Fix"
                            ToolTipService.ToolTip="Show how to turn it off" />
                    </Grid>
                    <Rectangle x:Name="WarningDivider" Style="{StaticResource MenuDivider}" Visibility="Collapsed" />

                    <!-- Captures. -->
                    <Button Style="{StaticResource MenuRow}" Click="OnRegion">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" StrokeWidth="2" Dashed="True" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Region" />
                                <TextBlock x:Name="RegionHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="OnWindow">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 9h18" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Window" />
                                <TextBlock x:Name="WindowHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="OnFullScreen">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Full screen" />
                                <TextBlock x:Name="FullScreenHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="OnRecord">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M5 6h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM16 10l5-3v10l-5-3" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Record video" />
                                <TextBlock x:Name="RecordHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="RepeatRow" Style="{StaticResource MenuRow}" Click="OnRepeatRegion">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Repeat last region" />
                                <TextBlock x:Name="RepeatHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Rectangle Style="{StaticResource MenuDivider}" />
                    <Button Style="{StaticResource MenuRow}" Click="OnShowToolbar">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M4 9h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zM7 12h.01M11 12h2" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Show toolbar" />
                        </Grid>
                    </Button>
                    <Button x:Name="ClickThroughRow" Style="{StaticResource MenuRow}" Click="OnReleasePins" Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M5 3l14 7-6 2-2 6z" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Make pinned captures clickable" />
                        </Grid>
                    </Button>

                    <Rectangle Style="{StaticResource MenuDivider}" />
                    <!-- The tick sits in the icon column, so the label lines up with every other row. -->
                    <Button Style="{StaticResource MenuRow}" Click="OnStartWithWindows">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon x:Name="StartupTick" Size="16" StrokeWidth="2.2" Data="M5 12l5 5 9-10" Foreground="{ThemeResource CaptaAccentTextBrush}" Visibility="Collapsed" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Start with Windows" />
                                <TextBlock x:Name="StartupHint" Style="{StaticResource MenuHint}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Rectangle Style="{StaticResource MenuDivider}" />
                    <Button Style="{StaticResource MenuRow}" Click="OnSettings">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M18 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM12 12a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM20 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0z" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Settings…" />
                        </Grid>
                    </Button>
                    <!-- Only until first-run setup has been completed. -->
                    <Button x:Name="SetupRow" Style="{StaticResource MenuRow}" Click="OnSetup" Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Set up Capta…" />
                        </Grid>
                    </Button>

                    <!-- Not in Store builds: the Store updates the app. -->
                    <Rectangle x:Name="UpdatesDivider" Style="{StaticResource MenuDivider}" />
                    <Button x:Name="UpdatesRow" Style="{StaticResource MenuRow}" Click="OnCheckForUpdates">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M12 4v12M7 11l5 5 5-5M5 20h14" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Check for updates" />
                        </Grid>
                    </Button>

                    <Rectangle Style="{StaticResource MenuDivider}" />
                    <Button Style="{StaticResource MenuRow}" Click="OnAbout">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v5M12 8h.01" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="About Capta…" />
                        </Grid>
                    </Button>

                    <Rectangle Style="{StaticResource MenuDivider}" />
                    <Button Style="{StaticResource MenuRow}" Click="OnExit">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:LineIcon Size="16" Data="M6 6l12 12M18 6L6 18" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Exit" />
                        </Grid>
                    </Button>
                </StackPanel>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
