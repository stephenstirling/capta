<?xml version="1.0" encoding="utf-8"?>
<!-- First-run setup: design/mockups/FirstRun.html and screenshots/08-first-run.png. -->
<Window
    x:Class="Capta.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Set up Capta">

    <!-- Transparent window; the padding leaves room for the dialog's shadow. -->
    <Grid x:Name="Root" Padding="24,12,24,36">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="StepTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="26" />
                    <Setter Property="FontWeight" Value="ExtraBold" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="StepBody" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14.5" />
                    <Setter Property="LineHeight" Value="22" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource CaptaTextSecondaryBrush}" />
                </Style>
                <Style x:Key="Switch" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,-12,0" />
                </Style>
                <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Padding" Value="16,0" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <!-- Step dots: the current step is a 22px pill; done and current steps are amber. -->
                <Style x:Key="DotCurrent" TargetType="Border">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="CornerRadius" Value="3" />
                    <Setter Property="Background" Value="{ThemeResource CaptaAccentBrush}" />
                </Style>
                <Style x:Key="DotDone" TargetType="Border" BasedOn="{StaticResource DotCurrent}">
                    <Setter Property="Width" Value="6" />
                </Style>
                <Style x:Key="DotTodo" TargetType="Border" BasedOn="{StaticResource DotDone}">
                    <Setter Property="Background" Value="{ThemeResource CaptaDividerBrush}" />
                </Style>
                <Style x:Key="RingOn" TargetType="Border">
                    <Setter Property="BorderBrush" Value="{ThemeResource CaptaAccentBrush}" />
                </Style>
                <Style x:Key="RingOff" TargetType="Border">
                    <Setter Property="BorderBrush" Value="{ThemeResource CaptaBorderStrongBrush}" />
                </Style>
                <!-- Theme choice: a two-tone preview with a ring when selected. -->
                <Style x:Key="ThemeChoice" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="12" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Width="760"
            Height="560"
            Background="{ThemeResource CaptaSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusWindow}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="14" Foreground="{ThemeResource CaptaTextBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="76" />
                    </Grid.RowDefinitions>

                    <!-- Header (drag region): glyph, title, step dots. -->
                    <Grid x:Name="TitleRow" Padding="20,0" Background="Transparent" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 9V5.5A2.5 2.5 0 0 1 5.5 3H9M15 3h3.5A2.5 2.5 0 0 1 21 5.5V9" Stroke="{ThemeResource CaptaAccentBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M3 15v3.5A2.5 2.5 0 0 0 5.5 21H9M21 15v3.5a2.5 2.5 0 0 1-2.5 2.5H15" Stroke="{ThemeResource CaptaApertureLowerBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Ellipse Canvas.Left="7.8" Canvas.Top="7.8" Width="8.4" Height="8.4" Fill="{ThemeResource CaptaLensBrush}" />
                                <Ellipse Canvas.Left="10.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="{ThemeResource CaptaAccentBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="Set up Capta" />
                        <StackPanel x:Name="Dots" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" />
                    </Grid>

                    <!-- Steps. -->
                    <Grid Grid.Row="1" Padding="48,8,48,0">

                        <!-- 0: Welcome -->
                        <StackPanel x:Name="Step0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
                            <!-- The artwork spans ~200 of the 256 units, so this renders the mark at ~88px. -->
                            <Viewbox Width="112" Height="112" HorizontalAlignment="Center">
                                <Canvas Width="256" Height="256">
                                    <Path Data="M40 100V64a24 24 0 0 1 24-24h36M156 40h36a24 24 0 0 1 24 24v36" Stroke="{ThemeResource CaptaAccentBrush}" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M40 156v36a24 24 0 0 0 24 24h36M216 156v36a24 24 0 0 1-24 24h-36" Stroke="{ThemeResource CaptaApertureLowerBrush}" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="92" Canvas.Top="92" Width="72" Height="72" Fill="{ThemeResource CaptaLensBrush}" />
                                    <Ellipse Canvas.Left="113" Canvas.Top="113" Width="30" Height="30" Fill="{ThemeResource CaptaAccentBrush}" />
                                    <Ellipse Canvas.Left="114" Canvas.Top="113" Width="10" Height="10" Fill="{ThemeResource CaptaGlyphHighlightBrush}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="ExtraBold" CharacterSpacing="-10" Text="Welcome to Capta" />
                            <TextBlock
                                MaxWidth="400"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                LineHeight="23"
                                Foreground="{ThemeResource CaptaTextSecondaryBrush}"
                                Text="Capture, mark up and file screenshots in a couple of keystrokes. Three quick choices and you're set."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 1: Print Screen -->
                        <StackPanel x:Name="Step1" VerticalAlignment="Center" Spacing="18" Visibility="Collapsed">
                            <Border
                                HorizontalAlignment="Left"
                                Padding="20,12"
                                Background="{ThemeResource CaptaKeyCapSurfaceBrush}"
                                BorderBrush="{ThemeResource CaptaKeyCapBorderBrush}"
                                BorderThickness="1,1,1,4"
                                CornerRadius="12">
                                <TextBlock FontFamily="{StaticResource CaptaMonoFont}" FontSize="22" FontWeight="SemiBold" Text="PrtSc" />
                            </Border>
                            <TextBlock Style="{StaticResource StepTitle}" Text="Use Print Screen for Capta" />
                            <TextBlock
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Style="{StaticResource StepBody}"
                                Text="Windows sends Print Screen to the Snipping Tool by default. Turn off &quot;Use the Print screen key to open screen capture&quot; in Windows settings and Capta takes over the key." />
                            <StackPanel x:Name="PrintScreenPending" Orientation="Horizontal" Spacing="10">
                                <Button
                                    Height="44"
                                    Padding="18,0"
                                    CornerRadius="10"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnOpenKeyboardSettings">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Open keyboard settings" />
                                        <c:LineIcon Size="16" StrokeWidth="2" Data="M7 17L17 7M9 7h8v8" />
                                    </StackPanel>
                                </Button>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Capta will notice the change automatically." />
                            </StackPanel>
                            <Border
                                x:Name="PrintScreenDone"
                                HorizontalAlignment="Left"
                                Padding="16,12"
                                Background="{ThemeResource CaptaSuccessSurfaceBrush}"
                                BorderBrush="{ThemeResource CaptaSuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:LineIcon Size="18" StrokeWidth="2.2" Data="M5 12l5 5 9-10" Foreground="{ThemeResource CaptaSuccessBrush}" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Print Screen now opens Capta" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2: Startup and appearance -->
                        <StackPanel x:Name="Step2" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Startup and appearance" />
                            <Border
                                Padding="16,0"
                                Background="{ThemeResource CaptaSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource CaptaListBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <Grid MinHeight="52" BorderBrush="{ThemeResource CaptaBorderBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock VerticalAlignment="Center" Text="Start Capta when Windows starts" />
                                        <ToggleSwitch x:Name="StartWithWindows" Style="{StaticResource Switch}" Margin="0,0,-12,0" />
                                    </Grid>
                                    <Grid MinHeight="52">
                                        <TextBlock VerticalAlignment="Center" Text="Start quietly in the system tray" />
                                        <ToggleSwitch x:Name="StartQuietly" Style="{StaticResource Switch}" Margin="0,0,-12,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Theme" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ThemeSystem" Style="{StaticResource ThemeChoice}" Tag="System" Click="OnTheme">
                                    <StackPanel Spacing="8">
                                        <Border x:Name="ThemeSystemRing" Padding="2" BorderThickness="2" CornerRadius="12">
                                            <Grid Height="74" CornerRadius="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewLightBackgroundBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewLightInkBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewDarkSurfaceBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewDarkInkBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="2,0" FontSize="13" FontWeight="SemiBold" Text="Match Windows" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ThemeLight" Grid.Column="1" Style="{StaticResource ThemeChoice}" Tag="Light" Click="OnTheme">
                                    <StackPanel Spacing="8">
                                        <Border x:Name="ThemeLightRing" Padding="2" BorderThickness="2" CornerRadius="12">
                                            <Grid Height="74" CornerRadius="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewLightSurfaceBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewLightInkBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewLightBackgroundBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewLightInkSoftBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="2,0" FontSize="13" FontWeight="SemiBold" Text="Light" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ThemeDark" Grid.Column="2" Style="{StaticResource ThemeChoice}" Tag="Dark" Click="OnTheme">
                                    <StackPanel Spacing="8">
                                        <Border x:Name="ThemeDarkRing" Padding="2" BorderThickness="2" CornerRadius="12">
                                            <Grid Height="74" CornerRadius="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewDarkSurfaceBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewDarkInkBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Padding="10" Spacing="6" Background="{ThemeResource CaptaPreviewDarkBackgroundBrush}">
                                                    <Rectangle Height="6" Width="30" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaPreviewDarkInkSoftBrush}" />
                                                    <Rectangle Height="6" Width="20" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource CaptaAccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="2,0" FontSize="13" FontWeight="SemiBold" Text="Dark" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 3: Connect Ocula -->
                        <StackPanel x:Name="Step3" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Connect Ocula" />
                            <Grid
                                Padding="16"
                                Background="{ThemeResource CaptaSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource CaptaListBorderBrush}"
                                BorderThickness="1"
                                ColumnSpacing="14"
                                CornerRadius="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{ThemeResource CaptaControlBrush}" CornerRadius="11">
                                    <c:LineIcon Size="20" StrokeWidth="1.9" Data="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="OculaTitle" FontSize="15" FontWeight="Bold" Text="Ocula is installed" />
                                    <TextBlock
                                        x:Name="OculaDetail"
                                        Margin="0,2,0,0"
                                        FontSize="13"
                                        Foreground="{ThemeResource CaptaFloatingMutedBrush}"
                                        Text="Captures appear in its &quot;All captures&quot; smart folder, searchable by the text inside them."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <c:LineIcon x:Name="OculaCheck" Grid.Column="2" VerticalAlignment="Center" Size="20" StrokeWidth="2.2" Data="M5 12l5 5 9-10" Foreground="{ThemeResource CaptaSuccessBrush}" />
                            </Grid>
                            <Grid MinHeight="48">
                                <TextBlock x:Name="SendToOculaLabel" VerticalAlignment="Center" Text="Send every capture to Ocula automatically" />
                                <ToggleSwitch x:Name="SendToOcula" Style="{StaticResource Switch}" Margin="0,0,-12,0" />
                            </Grid>
                            <Grid Padding="14,12" Background="{ThemeResource CaptaInsetBrush}" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <c:LineIcon Size="17" Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" Foreground="{ThemeResource CaptaFloatingTextBrush}" />
                                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource CaptaFloatingTextBrush}" Text="Pictures › Captures" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <HyperlinkButton HorizontalAlignment="Right" Padding="6,2" FontSize="13" FontWeight="SemiBold" Click="OnChangeFolder" Content="Change">
                                    <HyperlinkButton.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource CaptaAccentTextColor}" />
                                                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource CaptaAccentTextColor}" />
                                                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource CaptaAccentTextColor}" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource CaptaAccentTextColor}" />
                                                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource CaptaAccentTextColor}" />
                                                    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource CaptaAccentTextColor}" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="CaptaAccentTextBrush" />
                                                    <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="CaptaAccentTextBrush" />
                                                    <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="CaptaAccentTextBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </HyperlinkButton.Resources>
                                </HyperlinkButton>
                            </Grid>
                            <TextBlock
                                x:Name="FolderNote"
                                FontSize="12.5"
                                Foreground="{ThemeResource CaptaTextMutedBrush}"
                                Text="Save starts in this folder."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 4: Done -->
                        <StackPanel x:Name="Step4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" Visibility="Collapsed">
                            <Border
                                HorizontalAlignment="Center"
                                Padding="24,14"
                                Background="{ThemeResource CaptaAccentBrush}"
                                BorderBrush="{ThemeResource CaptaAccentShadeBrush}"
                                BorderThickness="0,0,0,5"
                                CornerRadius="14">
                                <TextBlock FontFamily="{StaticResource CaptaMonoFont}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource CaptaOnAccentBrush}" Text="PrtSc" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="ExtraBold" Text="You're set" />
                            <TextBlock
                                MaxWidth="460"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                LineHeight="23"
                                Foreground="{ThemeResource CaptaTextSecondaryBrush}"
                                Text="Press Print Screen any time. Capta waits in the system tray, and right-click its icon for everything else."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <CheckBox
                                x:Name="ShowToolbarNow"
                                HorizontalAlignment="Center"
                                FontSize="13.5"
                                Foreground="{ThemeResource CaptaFloatingTextBrush}"
                                Content="Show the floating toolbar now"
                                IsChecked="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Back · Skip · primary. -->
                    <Grid Grid.Row="2" Padding="24,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Style="{StaticResource FooterButton}" Click="OnBack" Content="Back" Visibility="Collapsed" />
                        <Button x:Name="SkipButton" Grid.Column="2" Style="{StaticResource FooterButton}" Click="OnNext" Content="Skip" Visibility="Collapsed" />
                        <Button
                            x:Name="PrimaryButton"
                            Grid.Column="3"
                            Height="44"
                            Padding="24,0"
                            CornerRadius="10"
                            FontSize="14"
                            FontWeight="Bold"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnNext"
                            Content="Get started" />
                        <!-- While Print Screen is still Windows', the primary is neutral (the mockup's waiting state). -->
                        <Button
                            x:Name="WaitingButton"
                            Grid.Column="3"
                            Height="44"
                            Padding="24,0"
                            CornerRadius="10"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="OnNext"
                            Content="Next"
                            Visibility="Collapsed">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaKeyCapSurfaceColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlRaisedColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaKeyCapSurfaceColor}" />
                                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextMutedColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextSecondaryColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextMutedColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaKeyCapSurfaceColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlRaisedColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaKeyCapSurfaceColor}" />
                                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextMutedColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextSecondaryColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextMutedColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaKeyCapSurfaceBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaControlRaisedBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaKeyCapSurfaceBrush" />
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaTextMutedBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextSecondaryBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaTextMutedBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
