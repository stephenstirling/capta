<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Capta.Views.CaptureCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capta">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="12"
        RowSpacing="10"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource StirlingAccentStrongBrush}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Copied to clipboard" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Click="OnClose"
                ToolTipService.ToolTip="Dismiss (Esc)">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            MaxHeight="190"
            HorizontalAlignment="Center"
            BorderBrush="{ThemeResource StirlingStrokeBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image x:Name="Thumbnail" Stretch="Uniform" />
                <Border
                    Margin="6"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#B31E1A14"
                    CornerRadius="4">
                    <TextBlock x:Name="SizeText" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource CardButton}" Click="OnCopy" ToolTipService.ToolTip="Copy as PNG">
                <StackPanel Spacing="2">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    <TextBlock Text="Copy" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource CardButton}" Click="OnEdit" ToolTipService.ToolTip="Edit in Ocula">
                <StackPanel Spacing="2">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    <TextBlock Text="Edit" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource CardButton}" Click="OnSave" ToolTipService.ToolTip="Save as PNG">
                <StackPanel Spacing="2">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                    <TextBlock Text="Save" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource CardButton}" Click="OnPin" ToolTipService.ToolTip="Pin on top of other windows">
                <StackPanel Spacing="2">
                    <FontIcon Glyph="&#xE718;" FontSize="16" />
                    <TextBlock Text="Pin" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
