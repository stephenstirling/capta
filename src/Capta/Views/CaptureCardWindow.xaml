<?xml version="1.0" encoding="utf-8"?>
<!-- After-capture card: design/mockups/Toolbar.html (bottom-right card and Copy menu). -->
<Window
    x:Class="Capta.Views.CaptureCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid
        x:Name="Root"
        Padding="28,8,28,48"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="OnCopyTextAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Rows in the Copy menu. -->
                <Style x:Key="MenuRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="36,6,10,6" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{ThemeResource CaptaTextBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Width="400"
            Padding="14"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusToolbar}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13">
                <StackPanel Spacing="12">

                    <!-- Thumbnail, status and dismiss. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="60" Background="{ThemeResource CaptaControlBrush}" CornerRadius="8">
                            <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="SuccessDot" Fill="{ThemeResource CaptaSuccessBrush}" />
                                    <Ellipse x:Name="NeutralDot" Fill="{ThemeResource CaptaTextFaintBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="StatusText" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource CaptaTextBrush}" Text="Copied to clipboard" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DetailText" Margin="0,3,0,0" FontSize="12" Foreground="{ThemeResource CaptaFloatingMutedBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            Click="OnClose"
                            ToolTipService.ToolTip="Dismiss (Esc)">
                            <c:LineIcon Size="14" StrokeWidth="2" Data="M6 6l12 12M18 6L6 18" />
                        </Button>
                    </Grid>

                    <!-- Actions. Copy is a split button; Edit is the primary action. -->
                    <Grid ColumnSpacing="6">
                        <Grid.Resources>
                            <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlHoverBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaControlRaisedBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaControlHoverBrush" />
                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="CaptaControlHoverBrush" />
                            <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaTextBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaTextBrush" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The Copy menu opens above the whole split button, aligned to its left edge. -->
                        <StackPanel x:Name="CopySplit" Orientation="Horizontal">
                            <StackPanel.Resources>
                                    <Flyout x:Key="CopyMenuFlyout" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{ThemeResource CaptaMenuSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{ThemeResource CaptaDividerBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="12" />
                                                <Setter Property="Padding" Value="6" />
                                                <Setter Property="MinWidth" Value="300" />
                                                <Setter Property="MaxWidth" Value="300" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />
                                            </StackPanel.Resources>

                                            <!-- Default action: highlighted, with a check. -->
                                            <Button Style="{StaticResource MenuRow}" Padding="10,6" Background="{ThemeResource CaptaMenuItemSelectedBrush}" Click="OnCopyImage">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <c:LineIcon Size="16" StrokeWidth="2.4" Data="M5 12l5 5 9-10" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Copy image" />
                                                        <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="PNG · SDR · works everywhere" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Ctrl+C" />
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource MenuRow}" IsEnabled="False" ToolTipService.ToolTip="Coming soon">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Copy image as HDR" />
                                                    <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="JPEG XR · for HDR-aware apps" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MenuRow}" Click="OnCopyText">
                                                <Grid>
                                                    <TextBlock FontWeight="SemiBold" Text="Copy text in image" />
                                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Ctrl+Shift+C" />
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource MenuRow}" Click="OnCopyAsFile">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="Copy as file" />
                                                    <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Paste into Explorer, email or chat" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CopyPathRow" Style="{StaticResource MenuRow}" Click="OnCopyPath" ToolTipService.ToolTip="Save the capture first">
                                                <TextBlock FontWeight="SemiBold" Text="Copy file path" />
                                            </Button>
                                            <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource CaptaDividerBrush}" />
                                            <Grid MinHeight="44" Padding="10,6">
                                                <TextBlock VerticalAlignment="Center" Text="Copy automatically after capture" />
                                                <ToggleSwitch
                                                    x:Name="AutoCopySwitch"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Right"
                                                    OffContent=""
                                                    OnContent=""
                                                    Toggled="OnAutoCopyToggled" />
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                            </StackPanel.Resources>
                            <Button Height="40" Padding="12,0" CornerRadius="10,0,0,10" BorderThickness="0" FontWeight="SemiBold" Click="OnCopy" ToolTipService.ToolTip="Copy image (Ctrl+C)">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:LineIcon Size="16" Data="M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CopyMenuButton"
                                Click="OnCopyMenuClick"
                                Width="30"
                                Height="40"
                                Padding="0"
                                CornerRadius="0,10,10,0"
                                BorderThickness="1,0,0,0"
                                ToolTipService.ToolTip="Copy options">
                                <Button.Resources>
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlRaisedBrush" />
                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CaptaDividerBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CaptaDividerBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CaptaDividerBrush" />
                                </Button.Resources>
                                <c:LineIcon Size="13" StrokeWidth="2.2" Data="M18 15l-6-6-6 6" />
                            </Button>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Height="40"
                            Padding="14,0"
                            HorizontalAlignment="Stretch"
                            CornerRadius="10"
                            FontWeight="Bold"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnEdit"
                            ToolTipService.ToolTip="Edit">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:LineIcon Size="16" StrokeWidth="2" Data="M4 20l4-1 11-11-3-3L5 16z" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnSave" ToolTipService.ToolTip="Save as">
                            <c:LineIcon Size="16" Data="M12 4v12M7 11l5 5 5-5M5 20h14" />
                        </Button>
                        <Button Grid.Column="3" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnPin" ToolTipService.ToolTip="Pin to screen">
                            <c:LineIcon Size="17" Data="M14 4l6 6M16 6l-5 5-4-1-2 2 7 7 2-2-1-4 5-5M8 16l-4 4" />
                        </Button>
                        <Button x:Name="OculaButton" Grid.Column="4" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnSendToOcula" ToolTipService.ToolTip="Send to Ocula">
                            <c:LineIcon Size="17" StrokeWidth="1.9" Data="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
