<?xml version="1.0" encoding="utf-8"?>
<!-- After-capture card: design/mockups/Toolbar.html (bottom-right card and Copy menu). -->
<Window
    x:Class="Capta.Views.CaptureCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid
        x:Name="Root"
        Padding="28,8,28,48"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="OnCopyTextAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Rows in the Copy menu. -->
                <Style x:Key="MenuRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="36,6,10,6" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{ThemeResource CaptaTextBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Width="400"
            Padding="14"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusToolbar}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13">
                <StackPanel Spacing="12">

                    <!-- Thumbnail, status and dismiss. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="60" Background="{ThemeResource CaptaControlBrush}" CornerRadius="8">
                            <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="SuccessDot" Fill="{ThemeResource CaptaSuccessBrush}" />
                                    <Ellipse x:Name="NeutralDot" Fill="{ThemeResource CaptaTextFaintBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="StatusText" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource CaptaTextBrush}" Text="Copied to clipboard" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DetailText" Margin="0,3,0,0" FontSize="12" Foreground="{ThemeResource CaptaFloatingMutedBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            Click="OnClose"
                            ToolTipService.ToolTip="Dismiss (Esc)">
                            <c:LineIcon Size="14" StrokeWidth="2" Data="M6 6l12 12M18 6L6 18" />
                        </Button>
                    </Grid>

                    <!-- Personal info that was blurred before the copy (design/mockups/Editor.html). -->
                    <Border
                        x:Name="RedactionCard"
                        Padding="14"
                        Background="{ThemeResource CaptaInfoSurfaceBrush}"
                        BorderBrush="{ThemeResource CaptaInfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:LineIcon Size="18" StrokeWidth="1.9" VerticalAlignment="Top" Foreground="{ThemeResource CaptaInfoBrush}" Data="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{ThemeResource CaptaTextBrush}" Text="Personal info found" />
                                    <TextBlock x:Name="RedactionDetail" Margin="0,2,0,0" FontSize="12" Foreground="{ThemeResource CaptaFloatingMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="28,0,0,0" Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="ReviewButton"
                                    Height="32"
                                    Padding="12,0"
                                    Background="{ThemeResource CaptaInfoButtonBrush}"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Content="Review"
                                    ToolTipService.ToolTip="Choose what's blurred">
                                    <Button.Flyout>
                                        <Flyout x:Name="ReviewFlyout" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False" Opening="OnReviewOpening" Closed="OnReviewClosed">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Background" Value="{ThemeResource CaptaMenuSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{ThemeResource CaptaDividerBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Padding" Value="10" />
                                                    <Setter Property="MinWidth" Value="320" />
                                                    <Setter Property="MaxWidth" Value="320" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel Spacing="2">
                                                <TextBlock Margin="2,0,0,6" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="BLURRED" />
                                                <StackPanel x:Name="ReviewList" Spacing="2" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    x:Name="UndoRedactionButton"
                                    Height="32"
                                    Padding="12,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Content="Undo"
                                    Click="OnUndoRedaction" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Actions. Copy is a split button; Edit is the primary action. -->
                    <Grid ColumnSpacing="6">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlRaisedColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaControlRaisedColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CaptaControlHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaTextColor}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaControlRaisedBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaControlHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="CaptaControlHoverBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="CaptaTextBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptaTextBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptaTextBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The Copy menu opens above the whole split button, aligned to its left edge. -->
                        <StackPanel x:Name="CopySplit" Orientation="Horizontal">
                            <StackPanel.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaHoverOverlayColor}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaPressedOverlayColor}" />
                                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource CaptaTextFaintColor}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptaHoverOverlayBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptaPressedOverlayBrush" />
                                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="CaptaTextFaintBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                        <Flyout x:Key="CopyMenuFlyout" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Background" Value="{ThemeResource CaptaMenuSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{ThemeResource CaptaDividerBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Padding" Value="6" />
                                                    <Setter Property="MinWidth" Value="300" />
                                                    <Setter Property="MaxWidth" Value="300" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel>
                                                <StackPanel.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                                </StackPanel.Resources>

                                                <!-- Default action: highlighted, with a check. -->
                                                <Button x:Name="CopyImageRow" Style="{StaticResource MenuRow}" Padding="10,6" Background="{ThemeResource CaptaMenuItemSelectedBrush}" Click="OnCopyImage">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <c:LineIcon Size="16" StrokeWidth="2.4" Data="M5 12l5 5 9-10" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontWeight="SemiBold" Text="Copy image" />
                                                            <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="PNG · SDR · works everywhere" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Ctrl+C" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="CopyHdrRow" Style="{StaticResource MenuRow}" Click="OnCopyHdr">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Copy image as HDR" />
                                                        <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="JPEG XR · for HDR-aware apps" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="CopyTextRow" Style="{StaticResource MenuRow}" Click="OnCopyText">
                                                    <Grid>
                                                        <TextBlock FontWeight="SemiBold" Text="Copy text in image" />
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource CaptaMonoFont}" FontSize="11" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Ctrl+Shift+C" />
                                                    </Grid>
                                                </Button>
                                                <Button Style="{StaticResource MenuRow}" Click="OnCopyAsFile">
                                                    <StackPanel>
                                                        <TextBlock x:Name="CopyAsFileText" FontWeight="SemiBold" Text="Copy as file" />
                                                        <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="Paste into Explorer, email or chat" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="GifRow" Style="{StaticResource MenuRow}" Click="OnSaveGif" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="Save as GIF" />
                                                        <TextBlock FontSize="11.5" Foreground="{ThemeResource CaptaFloatingMutedBrush}" Text="First 30 s · 10 fps · copied as a file too" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="CopyPathRow" Style="{StaticResource MenuRow}" Click="OnCopyPath" ToolTipService.ToolTip="Save the capture first">
                                                    <TextBlock FontWeight="SemiBold" Text="Copy file path" />
                                                </Button>
                                                <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource CaptaDividerBrush}" />
                                                <Grid MinHeight="44" Padding="10,6">
                                                    <TextBlock VerticalAlignment="Center" Text="Copy automatically after capture" />
                                                    <ToggleSwitch
                                                        x:Name="AutoCopySwitch"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Right"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="OnAutoCopyToggled" />
                                                </Grid>
                                            </StackPanel>
                                        </Flyout>
                                </ResourceDictionary>
                            </StackPanel.Resources>
                            <Button Height="40" Padding="12,0" CornerRadius="10,0,0,10" BorderThickness="0" FontWeight="SemiBold" Click="OnCopy" ToolTipService.ToolTip="Copy image (Ctrl+C)">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:LineIcon Size="16" Data="M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CopyMenuButton"
                                Click="OnCopyMenuClick"
                                Width="30"
                                Height="40"
                                Padding="0"
                                CornerRadius="0,10,10,0"
                                BorderThickness="1,0,0,0"
                                ToolTipService.ToolTip="Copy options">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Default">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlRaisedColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource CaptaDividerColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource CaptaDividerColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource CaptaDividerColor}" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource CaptaControlRaisedColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource CaptaDividerColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource CaptaDividerColor}" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource CaptaDividerColor}" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast">
                                                <StaticResource x:Key="ButtonBackground" ResourceKey="CaptaControlRaisedBrush" />
                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CaptaDividerBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CaptaDividerBrush" />
                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CaptaDividerBrush" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <c:LineIcon Size="13" StrokeWidth="2.2" Data="M18 15l-6-6-6 6" />
                            </Button>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Height="40"
                            Padding="14,0"
                            HorizontalAlignment="Stretch"
                            CornerRadius="10"
                            FontWeight="Bold"
                            Style="{StaticResource AccentButtonStyle}"
                            x:Name="EditButton"
                            Click="OnEdit"
                            ToolTipService.ToolTip="Edit">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:LineIcon x:Name="EditIcon" Size="16" StrokeWidth="2" Data="M4 20l4-1 11-11-3-3L5 16z" />
                                <TextBlock x:Name="EditText" Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnSave" ToolTipService.ToolTip="Save as">
                            <c:LineIcon Size="16" Data="M12 4v12M7 11l5 5 5-5M5 20h14" />
                        </Button>
                        <Button x:Name="PinButton" Grid.Column="3" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnPin" ToolTipService.ToolTip="Pin to screen">
                            <c:LineIcon Size="17" Data="M14 4l6 6M16 6l-5 5-4-1-2 2 7 7 2-2-1-4 5-5M8 16l-4 4" />
                        </Button>
                        <Button x:Name="OculaButton" Grid.Column="4" Width="44" Height="40" Padding="0" CornerRadius="10" BorderThickness="0" Click="OnSendToOcula" ToolTipService.ToolTip="Send to Ocula">
                            <c:LineIcon Size="17" StrokeWidth="1.9" Data="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
