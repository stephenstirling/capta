<?xml version="1.0" encoding="utf-8"?>
<!-- Floating toolbar: design/mockups/Toolbar.html (top bar). -->
<Window
    x:Class="Capta.Views.ToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid
        x:Name="Root"
        Padding="40,16,40,56">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Padding="6"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusToolbar}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13" FontWeight="SemiBold">
            <StackPanel Orientation="Horizontal" Spacing="2">

                <!-- Drag handle; registered as the title bar. -->
                <Grid
                    x:Name="Grip"
                    Width="24"
                    Height="44"
                    Background="Transparent"
                    ToolTipService.ToolTip="Move toolbar">
                    <Canvas Width="10" Height="18">
                        <Ellipse Canvas.Left="1" Canvas.Top="1.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                        <Ellipse Canvas.Left="6" Canvas.Top="1.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                        <Ellipse Canvas.Left="1" Canvas.Top="7.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                        <Ellipse Canvas.Left="6" Canvas.Top="7.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                        <Ellipse Canvas.Left="1" Canvas.Top="13.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                        <Ellipse Canvas.Left="6" Canvas.Top="13.5" Width="3" Height="3" Fill="{ThemeResource CaptaTextFaintBrush}" />
                    </Canvas>
                </Grid>

                <!-- Primary action: capture in the selected mode. -->
                <Button
                    x:Name="NewButton"
                    Height="44"
                    Margin="0,0,6,0"
                    Padding="16,0"
                    CornerRadius="11"
                    FontWeight="Bold"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnNew"
                    ToolTipService.ToolTip="New capture">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="18" Height="18">
                            <c:LineIcon Data="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" StrokeWidth="2.2" />
                            <Ellipse Width="4.6" Height="4.6" Fill="{ThemeResource CaptaOnAccentBrush}" />
                        </Grid>
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>

                <!-- Mode group: icon-only, the selected mode is highlighted. -->
                <Border Padding="3" Background="{ThemeResource CaptaInsetBrush}" CornerRadius="12">
                    <Border.Resources>
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="CaptaAccentSoftBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="CaptaAccentSoftBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="CaptaAccentSoftBrush" />
                        <Style x:Key="ModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="9" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="RegionMode" Style="{StaticResource ModeToggle}" Click="OnModeClick" Tag="Region" ToolTipService.ToolTip="Region (PrtSc)">
                            <c:LineIcon Data="M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" StrokeWidth="2" Dashed="True" />
                        </ToggleButton>
                        <ToggleButton x:Name="WindowMode" Style="{StaticResource ModeToggle}" Click="OnModeClick" Tag="Window" ToolTipService.ToolTip="Window (Alt+PrtSc captures the active window)">
                            <c:LineIcon Data="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 9h18" />
                        </ToggleButton>
                        <ToggleButton x:Name="FullScreenMode" Style="{StaticResource ModeToggle}" Click="OnModeClick" Tag="FullScreen" ToolTipService.ToolTip="Full screen (Shift+PrtSc)">
                            <c:LineIcon Data="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ModeToggle}" IsEnabled="False" ToolTipService.ToolTip="Freeform (coming soon)">
                            <c:LineIcon Data="M6 16c-2-3 0-9 5-10s9 2 8 6-6 3-7 6 2 4 4 3" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ModeToggle}" IsEnabled="False" ToolTipService.ToolTip="Scrolling (coming soon)">
                            <c:LineIcon Data="M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM12 8v8M9 13l3 3 3-3" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ModeToggle}" IsEnabled="False" ToolTipService.ToolTip="Record video (coming soon)">
                            <c:LineIcon Data="M5 6h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM16 10l5-3v10l-5-3" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Rectangle Width="1" Height="26" Margin="6,0" Fill="{ThemeResource CaptaDividerBrush}" />

                <Button x:Name="DelayButton" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Delay before capturing">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:LineIcon Size="17" Data="M20 13a8 8 0 1 1-16 0a8 8 0 1 1 16 0zM12 9v4l2 2M9 2h6" />
                        <TextBlock x:Name="DelayText" Text="Off" VerticalAlignment="Center" />
                        <c:LineIcon Size="13" StrokeWidth="2" Data="M6 9l6 6 6-6" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="DelayOff" Text="No delay" GroupName="Delay" Tag="0" Click="OnDelayClick" />
                            <RadioMenuFlyoutItem x:Name="Delay3" Text="3 seconds" GroupName="Delay" Tag="3" Click="OnDelayClick" />
                            <RadioMenuFlyoutItem x:Name="Delay5" Text="5 seconds" GroupName="Delay" Tag="5" Click="OnDelayClick" />
                            <RadioMenuFlyoutItem x:Name="Delay10" Text="10 seconds" GroupName="Delay" Tag="10" Click="OnDelayClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- On/off shows as the icon's check mark, not colour. -->
                <ToggleButton x:Name="AutoCopyToggle" Style="{StaticResource ToolToggle}" Click="OnAutoCopyClick" ToolTipService.ToolTip="Copy each capture to the clipboard automatically">
                    <ToggleButton.Resources>
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="CaptaFloatingTextBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="CaptaTextBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="CaptaFloatingTextBrush" />
                    </ToggleButton.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="17" Height="17">
                            <c:LineIcon Size="17" Data="M8 4h8a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM9 4V3h6v1" />
                            <c:LineIcon x:Name="AutoCopyCheck" Size="17" Data="M9 13l2 2 4-4" />
                        </Grid>
                        <TextBlock Text="Auto-copy" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Shown when the display under the toolbar is in HDR. -->
                <Border x:Name="HdrBadge" Height="44" Padding="10,0" Background="Transparent" Visibility="Collapsed">
                    <ToolTipService.ToolTip>
                        <StackPanel MaxWidth="250">
                            <TextBlock x:Name="HdrTitle" FontWeight="Bold" Text="Display 1 is in HDR" />
                            <TextBlock TextWrapping="Wrap" FontWeight="Normal" Text="Captures are tone-mapped to match what you see, using the Windows SDR brightness." />
                        </StackPanel>
                    </ToolTipService.ToolTip>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="6,3" BorderBrush="{ThemeResource CaptaAccentTextBrush}" BorderThickness="1.5" CornerRadius="5">
                            <TextBlock Text="HDR" FontSize="10.5" FontWeight="ExtraBold" CharacterSpacing="60" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <c:LineIcon Size="14" StrokeWidth="2" Data="M5 12h14M13 6l6 6-6 6" Foreground="{ThemeResource CaptaFloatingTextBrush}" />
                            <TextBlock Text="SDR" Foreground="{ThemeResource CaptaFloatingTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Rectangle Width="1" Height="26" Margin="6,0" Fill="{ThemeResource CaptaDividerBrush}" />

                <ToggleButton x:Name="KeepOnTopToggle" Style="{StaticResource ToolToggle}" Padding="0" Click="OnKeepOnTopClick" ToolTipService.ToolTip="Keep on top">
                    <c:LineIcon Size="17" Data="M9 4h6l-1 5 3 3H7l3-3zM12 12v8" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Padding="0" IsEnabled="False" ToolTipService.ToolTip="Settings (coming soon)">
                    <c:LineIcon Size="17" Data="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M18 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM12 12a2 2 0 1 1-4 0a2 2 0 1 1 4 0zM20 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0z" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Padding="0" Click="OnHide" ToolTipService.ToolTip="Hide to tray">
                    <c:LineIcon Size="16" Data="M5 12h14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Padding="0" Click="OnHide" ToolTipService.ToolTip="Close (Esc)">
                    <c:LineIcon Size="16" Data="M6 6l12 12M18 6L6 18" />
                </Button>
            </StackPanel>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
