<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Capta.Views.ToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capta">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="6" ColumnSpacing="4">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Drag handle: registered as the title bar so the toolbar can be moved. -->
        <Grid x:Name="Grip" Width="20" Background="Transparent" ToolTipService.ToolTip="Drag to move">
            <FontIcon Glyph="&#xE76F;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Button Grid.Column="1" Style="{StaticResource ModeButton}" Click="OnRegion" ToolTipService.ToolTip="Region (PrtSc)">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7A8;" FontSize="16" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                <TextBlock Text="Region" />
            </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource ModeButton}" Click="OnWindow" ToolTipService.ToolTip="Window (Alt+PrtSc captures the active window)">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                <TextBlock Text="Window" />
            </StackPanel>
        </Button>
        <Button Grid.Column="3" Style="{StaticResource ModeButton}" Click="OnFullScreen" ToolTipService.ToolTip="Full screen (Shift+PrtSc)">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE740;" FontSize="16" Foreground="{ThemeResource CaptaAccentTextBrush}" />
                <TextBlock Text="Full screen" />
            </StackPanel>
        </Button>

        <AppBarSeparator Grid.Column="4" Padding="0" />

        <Button Grid.Column="5" Style="{StaticResource ModeButton}" Padding="10,6" Click="OnClose" ToolTipService.ToolTip="Close (Esc)">
            <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>
    </Grid>
</Window>
