<?xml version="1.0" encoding="utf-8"?>
<!-- "Version 1.1.x is available · What's new · Download": opens the release page, installs nothing. -->
<Window
    x:Class="Capta.Views.UpdateCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta">

    <!-- Transparent window; the padding leaves room for the panel's shadow (see DESIGN.md decision 5). -->
    <Grid x:Name="Root" Padding="8,4,8,8">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Width="380"
            Padding="14"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusToolbar}">
            <ContentPresenter FontFamily="{StaticResource CaptaFont}" FontSize="13" Foreground="{ThemeResource CaptaTextBrush}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:LineIcon VerticalAlignment="Center" Size="20" StrokeWidth="2" Foreground="{ThemeResource CaptaAccentTextBrush}" Data="M12 4v12M7 11l5 5 5-5M5 20h14" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Text="Version 1.1.0 is available" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailText" Margin="0,3,0,0" FontSize="12" Foreground="{ThemeResource CaptaFloatingMutedBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            Click="OnClose"
                            ToolTipService.ToolTip="Dismiss (Esc)">
                            <c:LineIcon Size="14" StrokeWidth="2" Data="M6 6l12 12M18 6L6 18" />
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="40" HorizontalAlignment="Stretch" CornerRadius="10" FontWeight="SemiBold" Click="OnWhatsNew" Content="What's new" ToolTipService.ToolTip="Read the release notes in your browser" />
                        <Button
                            Grid.Column="1"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            CornerRadius="10"
                            FontWeight="Bold"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnDownload"
                            Content="Download"
                            ToolTipService.ToolTip="Open the download page in your browser. Capta doesn't download or install anything itself" />
                    </Grid>
                </StackPanel>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>
