<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while recording: elapsed time, audio sources and Stop. Styled like the floating toolbar. -->
<Window
    x:Class="Capta.Views.RecordingBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta recording">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid x:Name="Root" Padding="24,12,24,36">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="SourceToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="9" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Padding="6"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusToolbar}"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnPointerPressed"
            PointerReleased="OnPointerReleased">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <StackPanel
                    Padding="10,0,12,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Orientation="Horizontal"
                    Spacing="10"
                    ToolTipService.ToolTip="Recording · drag to move">
                    <Ellipse x:Name="Dot" Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource CaptaRecordBrush}" />
                    <TextBlock
                        x:Name="TimeText"
                        MinWidth="44"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CaptaMonoFont}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="0:00" />
                </StackPanel>

                <Rectangle Width="1" Height="26" Margin="4,0" VerticalAlignment="Center" Fill="{ThemeResource CaptaDividerBrush}" />

                <ToggleButton x:Name="SystemAudioToggle" Style="{StaticResource SourceToggle}" Click="OnSystemAudio" ToolTipService.ToolTip="Record system audio">
                    <c:LineIcon Data="M4 9h4l5-4v14l-5-4H4zM16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11" />
                </ToggleButton>
                <ToggleButton x:Name="MicToggle" Style="{StaticResource SourceToggle}" Click="OnMicrophone" ToolTipService.ToolTip="Record the microphone">
                    <c:LineIcon Data="M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM5 11a7 7 0 0 0 14 0M12 18v3" />
                </ToggleButton>

                <Rectangle Width="1" Height="26" Margin="4,0" VerticalAlignment="Center" Fill="{ThemeResource CaptaDividerBrush}" />

                <Button
                    x:Name="StopButton"
                    Height="40"
                    Padding="12,0,14,0"
                    Background="{ThemeResource CaptaRecordBrush}"
                    BorderThickness="0"
                    Click="OnStop"
                    CornerRadius="10"
                    FontWeight="Bold"
                    Foreground="{ThemeResource CaptaOnRecordBrush}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaRecordColor}" Opacity="0.88" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaRecordColor}" Opacity="0.75" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaOnRecordColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaOnRecordColor}" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CaptaRecordColor}" Opacity="0.88" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CaptaRecordColor}" Opacity="0.75" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CaptaOnRecordColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CaptaOnRecordColor}" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <c:LineIcon Size="14" StrokeWidth="2.4" Data="M7 7h10v10H7z" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
