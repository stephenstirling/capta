<?xml version="1.0" encoding="utf-8"?>
<!-- Pinned colour chip: the swatch at the bottom of design/mockups/Pinned.html. -->
<Window
    x:Class="Capta.Views.ColourChipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Capta.Controls"
    Title="Capta colour">

    <!-- Transparent window; the padding leaves room for the panel's shadow. -->
    <Grid x:Name="Root" Padding="24,12,24,36">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/Floating.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="ShadowHost" />

        <Border
            x:Name="Panel"
            Padding="8,8,6,8"
            Background="{ThemeResource CaptaFloatingSurfaceBrush}"
            BorderBrush="{ThemeResource CaptaFloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CaptaRadiusCard}"
            DoubleTapped="OnDoubleTapped"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnPointerPressed"
            PointerReleased="OnPointerReleased"
            ToolTipService.ToolTip="Drag to move · click the code to copy · double-click to unpin">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy hex" Click="OnCopyHex" />
                    <MenuFlyoutItem Text="Copy RGB" Click="OnCopyRgb" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Unpin" Click="OnUnpin" />
                </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border x:Name="Swatch" Width="36" Height="36" CornerRadius="8" />
                <Button
                    x:Name="HexButton"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="OnCopyHex"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Copy">
                    <TextBlock x:Name="HexText" FontFamily="{StaticResource CaptaMonoFont}" FontSize="13" />
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="OnUnpin"
                    CornerRadius="6"
                    Foreground="{ThemeResource CaptaAccentTextBrush}"
                    ToolTipService.ToolTip="Unpin">
                    <c:LineIcon Size="14" StrokeWidth="1.9" Data="M14 4l6 6M16 6l-5 5-4-1-2 2 7 7 2-2-1-4 5-5M8 16l-4 4" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
