<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Capta.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Capta.Overlay"
    Title="Capta overlay">

    <!-- One overlay per monitor. The backdrop is a frozen capture, so the window is fully opaque. -->
    <ContentControl
        x:Name="FocusHost"
        IsTabStop="True"
        UseSystemFocusVisuals="False"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        KeyDown="OnKeyDown">
        <local:CursorGrid
            x:Name="Root"
            Background="{ThemeResource CaptaOverlayBackgroundBrush}"
            RequestedTheme="Dark"
            PointerPressed="OnPointerPressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerExited="OnPointerExited">
            <Grid.Resources>
            </Grid.Resources>

            <Image x:Name="Backdrop" Stretch="Fill" />

            <!-- Even-odd fill: the outer rect dims everything, the hole un-dims the selection. -->
            <!-- Even-odd scrim, rebuilt in code: WinUI doesn't re-render a Path when child geometries change. -->
            <Path x:Name="Shade" Fill="{ThemeResource CaptaScrimBrush}" IsHitTestVisible="False" />

            <Canvas IsHitTestVisible="False">
                <Rectangle
                    x:Name="SelectionFrame"
                    Stroke="{ThemeResource CaptaAccentBrush}"
                    StrokeThickness="2"
                    Visibility="Collapsed" />

                <Border
                    x:Name="SizeBadge"
                    Background="{ThemeResource CaptaReadoutSurfaceBrush}"
                    CornerRadius="4"
                    Padding="8,3"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="SizeText"
                        FontFamily="{StaticResource CaptaMonoFont}"
                        FontSize="12"
                        Foreground="{ThemeResource CaptaFloatingTextBrush}" />
                </Border>

                <Border
                    x:Name="Loupe"
                    Background="{ThemeResource CaptaReadoutSurfaceBrush}"
                    BorderBrush="{ThemeResource CaptaAccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="4"
                    Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <Grid Width="120" Height="120">
                            <Image x:Name="LoupeImage" Width="120" Height="120" Stretch="Fill" />
                            <Rectangle
                                Width="10"
                                Height="10"
                                Margin="55,55,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Stroke="{ThemeResource CaptaAccentBrush}"
                                StrokeThickness="1.5" />
                        </Grid>
                        <TextBlock
                            x:Name="LoupeText"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource CaptaMonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource CaptaFloatingTextBrush}" />
                    </StackPanel>
                </Border>
            </Canvas>

            <Border
                x:Name="Hint"
                Margin="0,24,0,0"
                Padding="14,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource CaptaReadoutSurfaceBrush}"
                CornerRadius="8"
                IsHitTestVisible="False">
                <TextBlock x:Name="HintText" FontSize="13" Foreground="{ThemeResource CaptaFloatingTextBrush}" />
            </Border>
        </local:CursorGrid>
    </ContentControl>
</Window>
