<Project>
  <!--
    Optional, git-ignored machine overrides. MSIX packages can't be registered from a
    network share, so a checkout on a mapped drive can redirect bin/obj to local disk:

      <Project><PropertyGroup><StirlingLocalBuildRoot>$(LOCALAPPDATA)\StirlingBuild\</StirlingLocalBuildRoot></PropertyGroup></Project>
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />
  <PropertyGroup Condition="'$(StirlingLocalBuildRoot)' != ''">
    <BaseOutputPath>$(StirlingLocalBuildRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(StirlingLocalBuildRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- Shared by every Stirling project in this repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <Company>Stephen Stirling</Company>
    <Copyright>Copyright © Stephen Stirling</Copyright>
  </PropertyGroup>
</Project>
